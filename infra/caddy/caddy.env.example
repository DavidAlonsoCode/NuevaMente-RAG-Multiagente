# Future /etc/caddy/caddy.env, root:root 0600. No credentials here.
# Required: one explicit public DNS hostname, lowercase ASCII/punycode.
# No scheme, path, port, wildcard, IP address or trailing dot.
NUEVAMENTE_DOMAIN=
# Production paths; overrides are only for isolated synthetic validation.
CADDY_STORAGE_DIR=/var/lib/caddy
CADDY_LOG_DIR=/var/log/caddy
# TRUSTED_ORIGIN_SECRET is loaded ONLY from /etc/nuevamente/secrets/origin.env.
